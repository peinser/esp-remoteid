CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2
# BLE 5 Long Range advertises a full Message Pack (up to 234 bytes).
CONFIG_BT_NIMBLE_EXT_ADV_MAX_SIZE=251
CONFIG_REMOTEID_TRANSPORT_BLE=y
CONFIG_REMOTEID_TRANSPORT_WIFI_BEACON=n
CONFIG_REMOTEID_TRANSPORT_WIFI_NAN=n
CONFIG_REMOTEID_BLE_TX_POWER_P9=y
# Leave the native USB port free for the MAVLink USB Serial/JTAG transport by
# default; the secondary console is disabled so log output never shares that
# port. Logs still go to the primary UART0 console.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
